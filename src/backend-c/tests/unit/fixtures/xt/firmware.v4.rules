*nat
:ACME_PRE - [0:0]
:_NDM_DNAT - [0:0]
:_NDM_MASQ - [0:0]
-A PREROUTING -i eth3 -j _NDM_DNAT
-A PREROUTING -j ACME_PRE
-A POSTROUTING -j _NDM_MASQ
-A ACME_PRE -s 192.168.1.0/24 -p udp -m udp --dport 5353 -j RETURN
-A _NDM_DNAT -d 203.0.113.5/32 -p tcp -m tcp --dport 8443 -j DNAT --to-destination 192.168.1.10:443
-A _NDM_MASQ -o eth3 -j SNAT --to-source 203.0.113.5
-A _NDM_MASQ -o ppp0 -j MASQUERADE
COMMIT
