*nat
:FIRC_DNSOR - [0:0]
:FIRC_DNAT - [0:0]
:FIRC_g1 - [0:0]
:FIRC_bh - [0:0]
-A FIRC_DNSOR -p tcp -d 192.168.1.1 --dport 53 -j DNAT --to-destination :3553
-A FIRC_DNSOR -p udp -d 192.168.1.1 --dport 53 -j DNAT --to-destination :3553
-A FIRC_DNAT -d 198.18.0.1/32 -j DNAT --to-destination 93.184.216.34
-A FIRC_g1 -o nwg1 -m mark --mark 0x10000/0xff0000 -j MASQUERADE
-I PREROUTING 1 -j FIRC_DNSOR
-A PREROUTING -d 198.18.0.0/15 -j FIRC_DNAT
-A POSTROUTING -j FIRC_g1
-A POSTROUTING -j FIRC_bh
COMMIT
